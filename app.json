{
  "expo": {
    "name": "ForjaFit",
    "slug": "forjafit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#09090b"
      },
      "package": "com.forjafit.app",
      "permissions": [
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-av"
    ]
  }
}
